# ScanTract Docker Environment Configuration
# Copy this file to .env.docker and fill in your API keys
# =============================================================================

# Database Configuration
# =============================================================================
DB_PASSWORD=your_secure_db_password_here

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose one: openai, claude, gemini
LLM_PROVIDER=openai

# Optional: Custom base URL for OpenRouter or other OpenAI-compatible APIs
LLM_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# API Keys
# =============================================================================
# REQUIRED: Gemini API key (used for embeddings regardless of LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED: At least ONE of the following based on your LLM_PROVIDER choice
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# =============================================================================
# Optional: Model Overrides
# =============================================================================
# OpenAI model (default: gpt-3.5-turbo)
# For OpenRouter free tier: nvidia/nemotron-3-super-120b-a12b:free
OPENAI_MODEL=gpt-3.5-turbo

# Claude model (default: claude-3-haiku-20240307)
# CLAUDE_MODEL=claude-3-haiku-20240307

# Gemini model (default: models/gemini-3.7-flash)
# GEMINI_MODEL=models/gemini-3.7-flash

# =============================================================================
# Optional: Application Configuration
# =============================================================================
# Upload limits
# MAX_UPLOAD_SIZE_MB=15

# RAG context limits
# MAX_CONTEXT_TOKENS=4000
# DEDUPLICATION_THRESHOLD=0.95
# MIN_CHUNKS_PER_SOURCE=1

# LLM concurrency
# LLM_CONCURRENCY_LIMIT=5
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=30

# Logging
# LOG_LEVEL=INFO
